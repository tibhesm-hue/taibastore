{
  "name": "استقبال طيبة",
  "short_name": "استقبال طيبة",
  "lang": "ar",
  "dir": "rtl",
  "id": "/recv2",
  "start_url": "/recv.html?r=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6f5",
  "theme_color": "#0e5a3c",
  "icons": [
    {"src": "/i192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/i512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "/r/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {"name": "img", "accept": ["image/*"]},
        {"name": "card", "accept": ["text/vcard", "text/x-vcard", "text/directory", ".vcf"]}
      ]
    }
  }
}
